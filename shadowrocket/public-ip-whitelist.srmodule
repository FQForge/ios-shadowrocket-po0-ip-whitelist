#!name=公网 IP 自动加白
#!desc=网络切换时及每隔 5 分钟检查公网 IP。请先填写自己的加白 API。
#!arguments=api:unset, method:POST, families:46, token:unset, probe4:default, probe6:default
#!arguments-desc=api 填写加白接口的 HTTPS URL\nmethod 选择 GET 或 POST\nfamilies 选择 4、6 或 46\ntoken 填写 Bearer 后面的值，无 Token 时保留 unset\nprobe4、probe6 默认使用 ipify，也可填写直连 HTTPS 探测接口

[Rule]
DOMAIN,api.ipify.org,DIRECT
DOMAIN,api6.ipify.org,DIRECT

[Script]
PublicIPWhitelistSchedule = type=cron, cronexp="*/5 * * * *", timeout=60, script-path=https://raw.githubusercontent.com/OWNER/REPO/main/shadowrocket/public-ip-whitelist.js, argument="api={{{api}}}|method={{{method}}}|families={{{families}}}|token={{{token}}}|probe4={{{probe4}}}|probe6={{{probe6}}}"
PublicIPWhitelistNetwork = type=event, network-changed, timeout=60, script-path=https://raw.githubusercontent.com/OWNER/REPO/main/shadowrocket/public-ip-whitelist.js, argument="api={{{api}}}|method={{{method}}}|families={{{families}}}|token={{{token}}}|probe4={{{probe4}}}|probe6={{{probe6}}}"
