#!name=iOS 小火箭 po0 加白
#!desc=填写 po0 防火墙 Token 后，网络切换时及每隔 5 分钟检查并自动加白当前 IPv4 网段。
#!arguments=token:unset
#!arguments-desc=token 填写 po0 控制台「防火墙」卡片上 pgnfw_ 开头的完整 Token

[Rule]
IP-CIDR,124.221.69.228/32,DIRECT,no-resolve

[Script]
PublicIPWhitelistSchedule = type=cron, cronexp="*/5 * * * *", timeout=60, script-path=https://raw.githubusercontent.com/FQForge/ios-shadowrocket-po0-ip-whitelist/main/shadowrocket/public-ip-whitelist.js?v=2, argument="po0Token={{{token}}}"
PublicIPWhitelistNetwork = type=event, network-changed, timeout=60, script-path=https://raw.githubusercontent.com/FQForge/ios-shadowrocket-po0-ip-whitelist/main/shadowrocket/public-ip-whitelist.js?v=2, argument="po0Token={{{token}}}"
